# Copie este arquivo para ".env.local" (no seu computador) ou cadastre
# cada variável no painel da Hostinger. NUNCA coloque valores reais aqui.

# --- Supabase (Project Settings > API) ---
# Estas duas podem ir para o navegador: sozinhas não abrem nada, o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Esta chave ignora o RLS: nunca coloque no front-end.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ao painel ---
# Único e-mail autorizado a entrar no painel.
ADMIN_EMAIL=

# --- Instagram (usadas a partir da Etapa 2) ---
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_VERIFY_TOKEN=

# --- IA da legenda (Etapa 2/9) ---
ANTHROPIC_API_KEY=

# --- Agendador (Etapa 4) ---
CRON_SECRET=
